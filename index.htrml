<!-- ================= PROJECTS ================= -->

<section class="section" id="projects">

    <div class="section-heading">

        <p>PROJECTS</p>

        <h2>Featured Projects</h2>

        <span>
            Projects created while learning and improving my development skills.
        </span>

    </div>


    <div class="projects-grid">


        <!-- Portfolio -->

        <article class="project-card">

            <div class="project-image portfolio-img">

                <div class="mini-browser">

                    <div class="browser-bar"></div>

                    <div class="mini-content">

                        <div class="mini-line large"></div>
                        <div class="mini-line"></div>
                        <div class="mini-line short"></div>

                    </div>

                </div>

            </div>

            <div class="project-content">

                <div class="project-number">01</div>

                <h3>Personal Portfolio</h3>

                <p>
                    A responsive personal portfolio website showcasing
                    my education, skills, projects and contact information.
                </p>

                <div class="tech-stack">

                    <span>HTML</span>
                    <span>CSS</span>
                    <span>JavaScript</span>

                </div>

                <div class="project-links">

                    <a href="#" target="_blank">GitHub ↗</a>

                    <a href="#" target="_blank">Live Demo ↗</a>

                </div>

            </div>

        </article>


        <!-- Project 2 -->

        <article class="project-card">

            <div class="project-image">

                <div class="project-placeholder">
                    PROJECT
                </div>

            </div>

            <div class="project-content">

                <div class="project-number">02</div>

                <h3>Student Management System</h3>

                <p>
                    A student management project designed to manage
                    student records and demonstrate programming and
                    database concepts.
                </p>

                <div class="tech-stack">

                    <span>Java</span>
                    <span>SQL</span>
                    <span>DBMS</span>

                </div>

                <div class="project-links">

                    <a href="#" target="_blank">GitHub ↗</a>

                </div>

            </div>

        </article>


        <!-- Project 3 -->

        <article class="project-card">

            <div class="project-image">

                <div class="project-placeholder">
                    DATA
                </div>

            </div>

            <div class="project-content">

                <div class="project-number">03</div>

                <h3>Data Analysis Project</h3>

                <p>
                    A beginner-friendly data analysis project using
                    Python libraries to explore, clean and visualize data.
                </p>

                <div class="tech-stack">

                    <span>Python</span>
                    <span>Pandas</span>
                    <span>NumPy</span>

                </div>

                <div class="project-links">

                    <a href="#" target="_blank">GitHub ↗</a>

                </div>

            </div>

        </article>

    </div>

</section>


