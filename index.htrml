<!-- ================= HERO ================= -->

<section class="hero" id="home">

    <div class="hero-content">

        <p class="small-text">Hello, I'm</p>

        <h1>Ayush<br><span>Srivastava.</span></h1>

        <h2>BCA Student & Aspiring Software Developer</h2>

        <p class="hero-description">
            I am a BCA student passionate about programming, web development,
            data analysis and building useful projects with modern technologies.
        </p>

        <div class="hero-buttons">

            <a href="#projects" class="btn primary">
                View Projects
            </a>

            <a href="#contact" class="btn secondary">
                Contact Me
            </a>

        </div>

    </div>


    <div class="hero-card">

        <div class="code-window">

            <div class="window-top">
                <span></span>
                <span></span>
                <span></span>
            </div>

            <div class="code">
                <p><span class="purple">const</span> developer = {</p>

                <p class="indent">
                    name:
                    <span class="green">"Ayush"</span>,
                </p>

                <p class="indent">
                    degree:
                    <span class="green">"BCA"</span>,
                </p>

                <p class="indent">
                    skills:
                    <span class="green">["Java", "Python"]</span>,
                </p>

                <p class="indent">
                    learning:
                    <span class="green">"Web Development"</span>
                </p>

                <p>};</p>

                <p>
                    <span class="purple">console</span>.
                    <span class="blue">log</span>(developer);
                </p>
            </div>

        </div>

    </div>

</section>


<!-- ================= ABOUT ================= -->

<section class="section" id="about">

